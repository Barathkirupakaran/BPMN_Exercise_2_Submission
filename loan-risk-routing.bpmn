<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                   id="Definitions_LoanRiskProcess"
                   targetNamespace="http://camunda.org/schema/1.0/bpmn"
                   exporter="Camunda Modeler"
                   exporterVersion="5.x">

  <bpmn:process id="Process_LoanApplicationRisk" name="Loan Application Risk Routing" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1" name="Loan Application Submitted">
      <bpmn:outgoing>Flow_ToEvaluateRisk</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:businessRuleTask id="Task_EvaluateRisk" name="Evaluate Loan Risk"
        camunda:decisionRef="evaluate-loan-risk"
        camunda:decisionRefBinding="latest"
        camunda:mapDecisionResult="singleResult"
        camunda:resultVariable="riskAssessment">
      <bpmn:incoming>Flow_ToEvaluateRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_RiskRoute" name="Risk Tier?">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAutoApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToUnderwriterReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToAutoReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_AutoApprove" name="Auto-Approve and Disburse"
        camunda:type="external" camunda:topic="autoApproveAndDisburse">
      <bpmn:incoming>Flow_ToAutoApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndApproved</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_UnderwriterReview" name="Underwriter Review">
      <bpmn:incoming>Flow_ToUnderwriterReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndReviewed</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_AutoReject" name="Auto-Reject Notification"
        camunda:type="external" camunda:topic="autoRejectNotification">
      <bpmn:incoming>Flow_ToAutoReject</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Approved" name="Loan Approved">
      <bpmn:incoming>Flow_ToEndApproved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Reviewed" name="Sent for Review">
      <bpmn:incoming>Flow_ToEndReviewed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Rejected" name="Loan Rejected">
      <bpmn:incoming>Flow_ToEndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToEvaluateRisk" sourceRef="StartEvent_1" targetRef="Task_EvaluateRisk" />
    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="Task_EvaluateRisk" targetRef="Gateway_RiskRoute" />

    <bpmn:sequenceFlow id="Flow_ToAutoApprove" name="LOW" sourceRef="Gateway_RiskRoute" targetRef="Task_AutoApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" language="feel">riskAssessment.riskTier = "LOW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ToUnderwriterReview" name="MEDIUM or manual review" sourceRef="Gateway_RiskRoute" targetRef="Task_UnderwriterReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" language="feel">riskAssessment.riskTier = "MEDIUM" or riskAssessment.requiresManualReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ToAutoReject" name="HIGH and no manual review" sourceRef="Gateway_RiskRoute" targetRef="Task_AutoReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" language="feel">riskAssessment.riskTier = "HIGH" and riskAssessment.requiresManualReview = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ToEndApproved" sourceRef="Task_AutoApprove" targetRef="EndEvent_Approved" />
    <bpmn:sequenceFlow id="Flow_ToEndReviewed" sourceRef="Task_UnderwriterReview" targetRef="EndEvent_Reviewed" />
    <bpmn:sequenceFlow id="Flow_ToEndRejected" sourceRef="Task_AutoReject" targetRef="EndEvent_Rejected" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_LoanApplicationRisk">

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="128" y="243" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_EvaluateRisk_di" bpmnElement="Task_EvaluateRisk">
        <dc:Bounds x="250" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_RiskRoute_di" bpmnElement="Gateway_RiskRoute" isMarkerVisible="true">
        <dc:Bounds x="415" y="193" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="404" y="163" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AutoApprove_di" bpmnElement="Task_AutoApprove">
        <dc:Bounds x="560" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_UnderwriterReview_di" bpmnElement="Task_UnderwriterReview">
        <dc:Bounds x="560" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AutoReject_di" bpmnElement="Task_AutoReject">
        <dc:Bounds x="560" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="742" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="720" y="125" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Reviewed_di" bpmnElement="EndEvent_Reviewed">
        <dc:Bounds x="742" y="200" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="720" y="243" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="742" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="720" y="385" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ToEvaluateRisk_di" bpmnElement="Flow_ToEvaluateRisk">
        <di:waypoint x="188" y="218" />
        <di:waypoint x="250" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToGateway_di" bpmnElement="Flow_ToGateway">
        <di:waypoint x="350" y="218" />
        <di:waypoint x="415" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToAutoApprove_di" bpmnElement="Flow_ToAutoApprove">
        <di:waypoint x="440" y="193" />
        <di:waypoint x="440" y="100" />
        <di:waypoint x="560" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="447" y="140" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToUnderwriterReview_di" bpmnElement="Flow_ToUnderwriterReview">
        <di:waypoint x="465" y="218" />
        <di:waypoint x="560" y="218" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="472" y="188" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToAutoReject_di" bpmnElement="Flow_ToAutoReject">
        <di:waypoint x="440" y="243" />
        <di:waypoint x="440" y="360" />
        <di:waypoint x="560" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="447" y="290" width="82" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEndApproved_di" bpmnElement="Flow_ToEndApproved">
        <di:waypoint x="660" y="100" />
        <di:waypoint x="742" y="100" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEndReviewed_di" bpmnElement="Flow_ToEndReviewed">
        <di:waypoint x="660" y="218" />
        <di:waypoint x="742" y="218" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_ToEndRejected_di" bpmnElement="Flow_ToEndRejected">
        <di:waypoint x="660" y="360" />
        <di:waypoint x="742" y="360" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
